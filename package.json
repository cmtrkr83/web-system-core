{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5001",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build:client": "vite build",
    "build:server": "tsx script/build-server.ts",
    "build": "npm run build:client && npm run build:server",
